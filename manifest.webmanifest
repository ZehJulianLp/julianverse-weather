{
    "name": "Julianverse Weather",
    "short_name": "Weather",
    "description": "A private, lightweight weather app powered by Open-Meteo.",
    "start_url": "./",
    "scope": "./",
    "display": "standalone",
    "background_color": "#eef3f0",
    "theme_color": "#146c58",
    "orientation": "portrait-primary",
    "shortcuts": [
        {
            "name": "Berlin weather",
            "short_name": "Berlin",
            "url": "./?place=Berlin"
        },
        {
            "name": "Hannover weather",
            "short_name": "Hannover",
            "url": "./?place=Hannover"
        }
    ],
    "icons": [
        {
            "src": "icons/icon-192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "icons/icon-maskable-512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        }
    ]
}
